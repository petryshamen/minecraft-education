{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HJ Macro/Local geography v1/v2",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ],
      "default": 1
    },
    "macro_regions": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/area"
      }
    },
    "local_areas": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/area"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": -30000000,
        "maximum": 30000000
      }
    },
    "ring": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/point"
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outer"
      ],
      "properties": {
        "outer": {
          "$ref": "#/$defs/ring"
        },
        "holes": {
          "type": "array",
          "maxItems": 127,
          "items": {
            "$ref": "#/$defs/ring"
          },
          "default": []
        }
      }
    },
    "area": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_][a-z0-9_.-]{0,63}$",
          "not": {
            "enum": [
              "none",
              "unknown"
            ]
          }
        },
        "dimension": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
        },
        "priority": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000,
          "default": 0
        },
        "macro_region": {
          "type": "string"
        },
        "display_label": {
          "type": "string",
          "maxLength": 48
        },
        "era_labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 48
          }
        },
        "profile": {
          "type": "object"
        },
        "polygon": {
          "type": "array",
          "minItems": 3,
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "geometry": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "outer"
              ],
              "properties": {
                "type": {
                  "const": "polygon"
                },
                "outer": {
                  "$ref": "#/$defs/ring"
                },
                "holes": {
                  "type": "array",
                  "maxItems": 127,
                  "items": {
                    "$ref": "#/$defs/ring"
                  },
                  "default": []
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "polygons"
              ],
              "properties": {
                "type": {
                  "const": "multipolygon"
                },
                "polygons": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 128,
                  "items": {
                    "$ref": "#/$defs/part"
                  }
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "schema_version"
        ],
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "properties": {
          "macro_regions": {
            "items": {
              "required": [
                "geometry"
              ],
              "not": {
                "required": [
                  "polygon"
                ]
              }
            }
          },
          "local_areas": {
            "items": {
              "required": [
                "geometry"
              ],
              "not": {
                "required": [
                  "polygon"
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "macro_regions": {
            "items": {
              "required": [
                "polygon"
              ],
              "not": {
                "required": [
                  "geometry"
                ]
              }
            }
          },
          "local_areas": {
            "items": {
              "required": [
                "polygon"
              ],
              "not": {
                "required": [
                  "geometry"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$comment": "Core additionally validates topology, labels/IDs/profiles/era labels, parents, total4096vertices/128rings per v2 area and aggregate budgets. macro_region is only valid for Locals."
}
