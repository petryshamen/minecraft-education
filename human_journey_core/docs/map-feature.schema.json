{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HJ Map Feature schema v1 / v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "label",
    "feature_type",
    "dimension",
    "geometry"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_][a-z0-9_.-]{0,63}$",
      "not": {
        "enum": [
          "none",
          "unknown"
        ]
      }
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "feature_type": {
      "enum": [
        "ocean",
        "sea",
        "gulf",
        "bay",
        "strait",
        "lake",
        "river"
      ]
    },
    "dimension": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
    },
    "priority": {
      "type": "integer",
      "minimum": -1000000,
      "maximum": 1000000,
      "default": 0
    },
    "discovery_radius": {
      "type": "number",
      "minimum": 1,
      "maximum": 64,
      "default": 8
    },
    "geometry": {
      "type": "object"
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": -30000000,
        "maximum": 30000000
      }
    },
    "ring": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/point"
      }
    },
    "line": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/point"
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outer"
      ],
      "properties": {
        "outer": {
          "$ref": "#/$defs/ring"
        },
        "holes": {
          "type": "array",
          "maxItems": 127,
          "items": {
            "$ref": "#/$defs/ring"
          },
          "default": []
        }
      }
    },
    "v1Geometry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "points"
          ],
          "properties": {
            "type": {
              "const": "polygon"
            },
            "points": {
              "type": "array",
              "minItems": 3,
              "maxItems": 512,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/point"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "points"
          ],
          "properties": {
            "type": {
              "const": "polyline"
            },
            "points": {
              "type": "array",
              "minItems": 2,
              "maxItems": 512,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/point"
              }
            }
          }
        }
      ]
    },
    "v2Geometry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "outer"
          ],
          "properties": {
            "type": {
              "const": "polygon"
            },
            "outer": {
              "$ref": "#/$defs/ring"
            },
            "holes": {
              "type": "array",
              "maxItems": 127,
              "items": {
                "$ref": "#/$defs/ring"
              },
              "default": []
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "polygons"
          ],
          "properties": {
            "type": {
              "const": "multipolygon"
            },
            "polygons": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": {
                "$ref": "#/$defs/part"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "points"
          ],
          "properties": {
            "type": {
              "const": "polyline"
            },
            "points": {
              "$ref": "#/$defs/line"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "geometry": {
            "$ref": "#/$defs/v1Geometry"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "properties": {
          "geometry": {
            "$ref": "#/$defs/v2Geometry"
          }
        }
      }
    }
  ],
  "$comment": "Core additionally validates topology, duplicate signed-zero vertices, total 128 rings / 4096 vertices per feature and catalog budgets."
}
