{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:human-journey:juice:2",
  "title": "HJ Core juice definitions v1/v2",
  "oneOf": [
    {
      "$ref": "#/$defs/v1"
    },
    {
      "$ref": "#/$defs/v2"
    }
  ],
  "$defs": {
    "resource": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$",
      "maxLength": 256
    },
    "v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "bottle_item",
        "ingredient",
        "canteen_display_name",
        "heal_per_drink"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_][a-z0-9_.-]{0,63}$"
        },
        "bottle_item": {
          "$ref": "#/$defs/resource"
        },
        "ingredient": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "item"
              ],
              "properties": {
                "item": {
                  "$ref": "#/$defs/resource"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tag"
              ],
              "properties": {
                "tag": {
                  "$ref": "#/$defs/resource"
                }
              }
            }
          ]
        },
        "canteen_display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?=.*\\S)[^\\x00-\\x1F\\x7F-\\x9F]+$"
        },
        "heal_per_drink": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "ingredient",
        "bottle_ingredient_count",
        "canteen_ingredient_count",
        "bottle",
        "canteen_display_name",
        "heal_per_drink"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_][a-z0-9_.-]{0,63}$"
        },
        "ingredient": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "item"
              ],
              "properties": {
                "item": {
                  "$ref": "#/$defs/resource"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tag"
              ],
              "properties": {
                "tag": {
                  "$ref": "#/$defs/resource"
                }
              }
            }
          ]
        },
        "bottle_ingredient_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "canteen_ingredient_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "bottle": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "item"
              ],
              "properties": {
                "type": {
                  "const": "native"
                },
                "item": {
                  "$ref": "#/$defs/resource"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "display_name",
                "effect_source_item"
              ],
              "properties": {
                "type": {
                  "const": "custom"
                },
                "display_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^(?=.*\\S)[^\\x00-\\x1F\\x7F-\\x9F]+$"
                },
                "effect_source_item": {
                  "$ref": "#/$defs/resource"
                }
              }
            }
          ]
        },
        "canteen_display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?=.*\\S)[^\\x00-\\x1F\\x7F-\\x9F]+$"
        },
        "heal_per_drink": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  },
  "description": "Runtime additionally validates supported exact TAN source items, finite healing, staged ingredient tags and catalog-wide ambiguity. V1 defaults native/1/1. No production catalog is bundled."
}
